FROM docker.io/library/python:3.14-slim
RUN pip install --no-cache-dir numpy==2.4.3
COPY rko_solver /opt/rko_solver
RUN rm -rf /opt/rko_solver/tests && chmod -R a-w /opt/rko_solver
ENV PYTHONPATH=/opt PYTHONDONTWRITEBYTECODE=1 OPENBLAS_NUM_THREADS=1 OMP_NUM_THREADS=1
USER 65534:65534
WORKDIR /tmp
CMD ["python", "-m", "rko_solver.experimental.self_evolve.worker"]
